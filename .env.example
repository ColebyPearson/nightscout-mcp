# Copy this file to .env and fill in real values. NEVER commit .env.

# Your Nightscout instance URL. MUST be https://.
NIGHTSCOUT_URL=https://your-nightscout.example.com

# A readable-role access token from Nightscout Admin Tools -> Subjects.
# Looks like: mcp-reader-ad3b1f9d7b3f59d5
# Do NOT use the raw API_SECRET here.
NIGHTSCOUT_TOKEN=mcp-reader-replace-me

# Default glucose units used when formatting LLM-friendly summaries.
# Allowed: "mmol/L" or "mg/dL". Tools still include both units in raw payloads.
NIGHTSCOUT_UNITS=mmol/L

# Phase 3 (deferred) — leave at false for now.
NIGHTSCOUT_ALLOW_WRITES=false
NIGHTSCOUT_WRITER_TOKEN=
